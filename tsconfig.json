{
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["es2022"],
        "outDir": "./.build",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "isolatedModules": true,
        "paths": {
            "@test/*": ["./.jest/*"],
            "@src/*": ["./src/*"],
            "@worker/*": ["./worker/*"],
            "@common/*": ["./common/src/*"],
            "@test-common/*": ["./common/.jest/*"]
        },
        "types": ["jest", "node"]
    },
    "include": ["src/**/*.ts", "worker/**/*.ts", ".jest/**/*.ts"],
    "exclude": ["node_modules", "common/**/*"]
}
